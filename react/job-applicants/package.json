    "axe-core": "^4.13.0",
    "concurrently": "^9.2.1",
    "dotenv-cli": "^11.0.0",
    "fallow": "^3.17.0",
    "fishery": "^2.4.0",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@job-applicants/schemas": "^1.0.0",
    "@orpc/client": "^1.14.8",
    "@orpc/contract": "^1.14.8",
    "@orpc/openapi": "^1.14.13",
    "@orpc/openapi-client": "^1.14.8",
    "@orpc/server": "^1.14.8",
    "@orpc/tanstack-query": "^1.14.8",
    "@orpc/zod": "^1.14.8"
