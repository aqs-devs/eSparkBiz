{
  "$schema": "./node_modules/fallow/schema.json",
  "entry": [
    "src/index.{ts,tsx,js,jsx}",
    "src/main.{ts,tsx,js,jsx}"
  ],
  "workspaces": {
    "patterns": [
      "apps/*",
      "packages/*"
    ]
  },
  "duplicates": {
    "minOccurrences": 3,
    "ignore": [
      "**/lib/**", 
      "**/legacy/**", 
      "**/__generated__/**", 
      "**/generated/**"
    ]
  },
  "rules": {}
}
