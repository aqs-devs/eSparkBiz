{
  "extends": "../../tsconfig.base.json",
    "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "paths": {
      "@job-applicants/ui/*": [
        "./src/*"
      ]
    },

    "noPropertyAccessFromIndexSignature": false,
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "outDir": "./dist",
    "rootDir": "./src"
  },
  "$comments": "shadcn-generated components use dot access on index-signature types. Do not modify generated components merely to satisfy this project-wide rule.",
  "include": ["."]
}
