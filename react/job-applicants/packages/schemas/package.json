{
  "name": "@job-applicants/schemas",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "dependencies": {
    "libphonenumber-js": "^1.13.8",
    "zod": "^4.3.6"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit --ignoreDeprecations 6.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    },
    "./applicants/*": {
      "types": "./dist/applicants/*.d.ts",
      "import": "./dist/applicants/*.js"
    },
    "./common/*": {
      "types": "./dist/common/*.d.ts",
      "import": "./dist/common/*.js"
    },
    "./applicants/validators/*": {
      "types": "./dist/applicants/validators/*.d.ts",
      "import": "./dist/applicants/validators/*.js"
    }
  },
  "files": [
    "dist"
  ]
}
