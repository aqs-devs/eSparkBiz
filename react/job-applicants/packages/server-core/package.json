{
    "name": "@job-applicants/server-core",
    "version": "1.0.0",
    "type": "module",
    "private": true,
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./*": {
        "types": "./dist/*.d.ts",
        "import": "./dist/*.js"
      }
    },
    "scripts": {
      "build": "tsc -b",
      "typecheck": "tsc --noEmit --ignoreDeprecations 6.0"
    },
    "files": ["dist"],
    "dependencies": {
      "@job-applicants/api-contract": "*",
      "@job-applicants/schemas": "*",
      "@job-applicants/shared": "*",
      "@orpc/openapi": "^1.14.10",
      "@orpc/server": "^1.14.8",
      "@orpc/zod": "^1.14.8",
      "country-state-city": "^3.2.1",
      "express-validator": "^7.3.2",
      "kysely": "^0.28.16",
      "mysql2": "^3.21.1"
    }
}
