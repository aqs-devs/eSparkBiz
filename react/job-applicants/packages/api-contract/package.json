{
  "name": "@job-applicants/api-contract",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit --ignoreDeprecations 6.0"
  },
  "files": ["dist"],
  "dependencies": {
    "@job-applicants/schemas": "*",
    "@orpc/contract": "^1.14.8"
  }
}
